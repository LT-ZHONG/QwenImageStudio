# Copy to backend/.env to override defaults (all variables are prefixed with QIS_).
# QIS_COMFYUI_URL=http://127.0.0.1:8188
# QIS_HOST=127.0.0.1          # use 0.0.0.0 to expose on the LAN (there is no authentication!)
# QIS_PORT=8000
# QIS_STORAGE_DIR=/data/qwen-image-studio/storage
# QIS_BACKUP_DIR=/data/qwen-image-studio/backups
# QIS_BACKUP_KEEP=14
# QIS_LOG_LEVEL=INFO
# QIS_MAX_UPLOAD_BYTES=20971520
# QIS_ORPHAN_UPLOAD_HOURS=24
